      "libibus-1.0-5",
      "libasound2",
      "libatk1.0-0",
      "libatk-bridge2.0-0",
      "libatspi2.0-0",
      "libcairo2",
      "libcups2",
      "libdbus-1-3",
      "libdrm2",
      "libexpat1",
      "libgbm1",
