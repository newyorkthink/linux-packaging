{
  "template": "appimage/linuxdeploy-gtk-deb.sh",
  "output": "discord/build_discord.sh",
  "params": {
    "APP_NAME": "discord",
    "APT_PACKAGES": [
      "dpkg-dev",
      "pkgconf",
      "libglib2.0-bin",
      "libglib2.0-dev",
      "libgirepository1.0-dev",
      "libgtk-3-bin",
      "libgtk-3-dev",
      "libgdk-pixbuf2.0-bin",
      "libgdk-pixbuf-2.0-dev",
      "librsvg2-dev",
      "librsvg2-common",
      "libpango1.0-dev",
      "ibus-gtk3",
      "libibus-1.0-5",
      "jq",
      "brotli",
      "libnss3",
      "libasound2",
      "libgbm1",
      "libxss1",
      "libxtst6",
      "libnotify4",
      "libpulse0",
      "libcups2",
      "libatomic1",
      "libappindicator3-1",
      "libc++1",
      "libc++abi1"
    ],
    "DEB_URL": "https://discord.com/api/download?platform=linux&format=deb",
    "DEB_FILENAME": "discord.deb",
    "DEB_PACKAGE": "discord",
    "DEB_ARCH": "amd64",
    "APP_BIN_DIR": "usr/lib/discord",
    "APP_LIB_DIR": "usr/lib/discord",
    "GIO_MODULE_DIR": "usr/lib/x86_64-linux-gnu/gio/modules",
    "MAIN_EXECUTABLE": "usr/lib/discord/Discord",
    "APPLICATION_PREPARE": "patches/prepare_application.sh",
    "APPLICATION_FINALIZE": "patches/prepare_application.sh",
    "APPRUN_PREPARE": "usr/lib/discord/prepare_modules.sh"
  }
}
