+
+// 按实际选中的主字体/备用字体计算 UTF-8 文本宽度，供多行标题按真实像素宽度换行。
+static unsigned int textWidthUtf8Fallback(XftFont *font,
+                                          XftFont **fallback_fonts,
+                                          int fallback_count,
+                                          const unsigned char *text, int len)
+{
+    int offset = 0;
+    unsigned int width = 0;
+
+    while (offset < len) {
+        XftFont *run_font;
+        int run_len = fontRunLength(font, fallback_fonts, fallback_count,
+                                    text + offset, len - offset, &run_font);
+        if (run_len <= 0 || !run_font)
+            break;
+
+        XGlyphInfo run_ext;
+        XftTextExtentsUtf8(dpy, run_font, text + offset, run_len, &run_ext);
+        width += run_ext.xOff;
+        offset += run_len;
+    }
+
+    return width;
+}
 
