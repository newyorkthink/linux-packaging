+// 解码单个 UTF-8 字符；非法序列按一个字节前进，避免卡住绘制循环。
+static int decodeUtf8Char(const unsigned char *text, int len, FcChar32 *codepoint)
+{
+    if (len <= 0)
+        return 0;
+    if (text[0] < 0x80) {
+        *codepoint = text[0];
+        return 1;
+    }
+    if (len >= 2 && (text[0] & 0xe0) == 0xc0
+        && (text[1] & 0xc0) == 0x80) {
+        *codepoint = ((FcChar32)(text[0] & 0x1f) << 6)
+                   | (FcChar32)(text[1] & 0x3f);
+        return 2;
+    }
+    if (len >= 3 && (text[0] & 0xf0) == 0xe0
+        && (text[1] & 0xc0) == 0x80
+        && (text[2] & 0xc0) == 0x80) {
+        *codepoint = ((FcChar32)(text[0] & 0x0f) << 12)
+                   | ((FcChar32)(text[1] & 0x3f) << 6)
+                   | (FcChar32)(text[2] & 0x3f);
+        return 3;
+    }
+    if (len >= 4 && (text[0] & 0xf8) == 0xf0
+        && (text[1] & 0xc0) == 0x80
+        && (text[2] & 0xc0) == 0x80
+        && (text[3] & 0xc0) == 0x80) {
+        *codepoint = ((FcChar32)(text[0] & 0x07) << 18)
+                   | ((FcChar32)(text[1] & 0x3f) << 12)
+                   | ((FcChar32)(text[2] & 0x3f) << 6)
+                   | (FcChar32)(text[3] & 0x3f);
+        return 4;
+    }
+
+    *codepoint = text[0];
+    return 1;
+}
+
+// 主字体缺少某个 UTF-8 字符时，才为该字符选择备用字体。
+static XftFont *fontForUtf8Char(XftFont *font, XftFont **fallback_fonts,
+                                int fallback_count,
+                                const unsigned char *text, int len,
+                                int *char_len)
+{
+    FcChar32 codepoint;
+    int consumed = decodeUtf8Char(text, len, &codepoint);
+
+    if (consumed <= 0) {
+        *char_len = 1;
+        return font;
+    }
+
+    *char_len = consumed;
+    if (font && XftCharExists(dpy, font, codepoint))
+        return font;
+    for (int i = 0; i < fallback_count; i++) {
+        if (fallback_fonts && fallback_fonts[i]
+            && XftCharExists(dpy, fallback_fonts[i], codepoint))
+            return fallback_fonts[i];
+    }
+    return font;
+}
+
+// 计算连续使用同一字体的一段 UTF-8 字节长度，避免逐字绘制英文。
+static int fontRunLength(XftFont *font, XftFont **fallback_fonts,
+                         int fallback_count,
+                         const unsigned char *text, int len,
+                         XftFont **run_font)
+{
+    int char_len;
+    int run_len;
+    XftFont *selected;
+
+    if (len <= 0)
+        return 0;
+
+    selected = fontForUtf8Char(font, fallback_fonts, fallback_count,
+                               text, len, &char_len);
+    *run_font = selected;
+    run_len = char_len;
+    while (run_len < len) {
+        int next_len;
+        XftFont *next = fontForUtf8Char(font, fallback_fonts,
+                                        fallback_count,
+                                        text + run_len, len - run_len,
+                                        &next_len);
+        if (next != selected)
+            break;
+        run_len += next_len;
+    }
+    return run_len;
+}
+
+// 按连续字体段绘制文本；已有字形继续使用主字体，缺失字形才回退。
+static void drawStringUtf8Fallback(XftDraw *draw, XftColor *color,
+                                   XftFont *font, XftFont **fallback_fonts,
+                                   int fallback_count,
+                                   const unsigned char *text, int len,
+                                   int x, int y)
+{
+    int offset = 0;
+    int cursor = x;
+
+    while (offset < len) {
+        XftFont *run_font;
+        int run_len = fontRunLength(font, fallback_fonts, fallback_count,
+                                    text + offset, len - offset, &run_font);
+        if (run_len <= 0 || !run_font)
+            break;
+
+        XGlyphInfo ext;
+        XftTextExtentsUtf8(dpy, run_font, text + offset, run_len, &ext);
+        XftDrawStringUtf8(draw, color, run_font, cursor, y,
+                          text + offset, run_len);
+        cursor += ext.xOff;
+        offset += run_len;
+    }
+}
