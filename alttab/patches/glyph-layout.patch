@@ -431,6 +431,44 @@ static int decodeUtf8Char(const unsigned char *text, int len, FcChar32 *codepoi
     return 1;
 }
 
+#define DYNAMIC_FALLBACK_CACHE_MAX 256
+
+typedef struct {
+    FcChar32 codepoint;
+    XftFont *font;
+} DynamicFallbackEntry;
+
+static DynamicFallbackEntry dynamicFallbackCache[DYNAMIC_FALLBACK_CACHE_MAX];
+static int dynamicFallbackCacheCount;
+
+// 固定备用字体仍缺字时，让 Fontconfig 按目标 Unicode 字符自动挑选宿主已安装字体。
+static XftFont *dynamicFallbackForCodepoint(XftFont *font, FcChar32 codepoint)
+{
+    for (int i = 0; i < dynamicFallbackCacheCount; i++) {
+        if (dynamicFallbackCache[i].codepoint == codepoint)
+            return dynamicFallbackCache[i].font;
+    }
+
+    if (dynamicFallbackCacheCount >= DYNAMIC_FALLBACK_CACHE_MAX)
+        return NULL;
+
+    char pattern[128];
+    int pixelsize = font && font->height > 0 ? font->height : 12;
+    snprintf(pattern, sizeof(pattern), ":pixelsize=%d:charset=%x",
+             pixelsize, codepoint);
+
+    XftFont *matched = XftFontOpenName(dpy, scr, pattern);
+    if (matched && !XftCharExists(dpy, matched, codepoint)) {
+        XftFontClose(dpy, matched);
+        matched = NULL;
+    }
+
+    dynamicFallbackCache[dynamicFallbackCacheCount].codepoint = codepoint;
+    dynamicFallbackCache[dynamicFallbackCacheCount].font = matched;
+    dynamicFallbackCacheCount++;
+    return matched;
+}
+
 // 主字体缺少某个 UTF-8 字符时，才为该字符选择备用字体。
 static XftFont *fontForUtf8Char(XftFont *font, XftFont **fallback_fonts,
                                 int fallback_count,
@@ -452,6 +488,10 @@ static XftFont *fontForUtf8Char(XftFont *font, XftFont **fallback_fonts,
             && XftCharExists(dpy, fallback_fonts[i], codepoint))
             return fallback_fonts[i];
     }
+    XftFont *dynamic_font = dynamicFallbackForCodepoint(font, codepoint);
+    if (dynamic_font)
+        return dynamic_font;
+
     return font;
 }
 
