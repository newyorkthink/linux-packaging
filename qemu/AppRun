#!/usr/bin/env bash
set -Eeuo pipefail

HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
tool="qemu-system-x86_64"
args=("$@")

if (( ${#args[@]} > 0 )); then
  candidate="${args[0]}"
  if [[ "$candidate" != */* ]] && [[ "$candidate" == qemu-* || "$candidate" == remote-viewer ]] && \
     [[ -x "$HERE/bin/$candidate" ]]; then
    tool="$candidate"
    args=("${args[@]:1}")
  fi
fi

if [[ "$tool" == qemu-system-* ]]; then
  for ((i = 0; i < ${#args[@]}; i++)); do
    case "${args[i]}" in
      -display)
        if (( i + 1 < ${#args[@]} )); then
          display="${args[i + 1]}"
          if [[ "$display" == gtk ]]; then
            args[i + 1]="gtk,clipboard=on"
          elif [[ "$display" == gtk,* && "$display" != *clipboard=* ]]; then
            args[i + 1]="$display,clipboard=on"
          fi
          ((i += 1))
        fi
        ;;
      -display=*)
        display="${args[i]#-display=}"
        if [[ "$display" == gtk ]]; then
          args[i]="-display=gtk,clipboard=on"
        elif [[ "$display" == gtk,* && "$display" != *clipboard=* ]]; then
          args[i]="-display=$display,clipboard=on"
        fi
        ;;
    esac
  done
fi

exec "$HERE/bin/$tool" "${args[@]}"
