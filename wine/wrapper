#!/usr/bin/env bash
set -Eeuo pipefail

# AppImageBuilder 的 AppRun 会提供 APPDIR 和 ARGV0。这里不设置 WINEPREFIX，
# 因而 Wine 默认继续使用 ~/.wine，并尊重用户显式传入的 WINEPREFIX。
WINE_ROOT="$APPDIR/opt/wine-staging"
WINE_BIN="$WINE_ROOT/bin/wine"
WINESERVER_LAUNCHER="$APPDIR/usr/bin/wineserver-launcher"

[[ -x "$WINE_BIN" ]] || {
  echo "错误：AppImage 内缺少 Wine 主程序：$WINE_BIN" >&2
  exit 1
}
[[ -x "$WINESERVER_LAUNCHER" ]] || {
  echo "错误：AppImage 内缺少 wineserver launcher：$WINESERVER_LAUNCHER" >&2
  exit 1
}

# Wine 通过 posix_spawn 启动 wineserver，而 AppRun v2 的 exec hook 不覆盖 posix_spawn。
# 先让 Wine 启动绝对 /bin/sh launcher，再由 shell 的 exec 进入 AppRun hook。
export WINESERVER="$WINESERVER_LAUNCHER"

# 固定 Wine/Windows 程序的界面消息为简体中文。AppRun 在较新的宿主上会使用宿主 glibc，
# 因此不能直接把 Jammy 预编译 locale 数据交给宿主 glibc；不同 glibc 版本的 locale
# 二进制格式可能不兼容。首次运行或缓存失效时，用目标机自己的 localedef 基于包内
# zh_CN/UTF-8 源数据生成本机兼容的独立 locale，后续直接复用。
prepare_chinese_locale() {
  local cache_root locale_dir

  cache_root="${XDG_CACHE_HOME:-$HOME/.cache}/appimage-wine/locale"
  locale_dir="$cache_root/zh_CN.UTF-8"

  if ! /usr/bin/env -u LD_PRELOAD -u LD_LIBRARY_PATH \
      LOCPATH="$cache_root" LC_ALL=zh_CN.UTF-8 \
      /usr/bin/locale charmap >/dev/null 2>&1; then
    command -v /usr/bin/localedef >/dev/null 2>&1 || {
      echo '错误：宿主系统缺少 /usr/bin/localedef，无法生成简体中文 locale。' >&2
      return 1
    }
    mkdir -p "$cache_root"
    rm -rf "$locale_dir"
    /usr/bin/env -u LD_PRELOAD -u LD_LIBRARY_PATH -u LOCPATH -u LC_ALL -u LC_MESSAGES \
      /usr/bin/localedef --no-archive \
      -i "$APPDIR/usr/share/i18n/locales/zh_CN" \
      -f "$APPDIR/usr/share/i18n/charmaps/UTF-8.gz" \
      "$locale_dir"
  fi

  export LOCPATH="$cache_root"
  export LANG="zh_CN.UTF-8"
  export LC_ALL="zh_CN.UTF-8"
  export LANGUAGE="zh_CN:zh"
}

prepare_chinese_locale

# Wine 11 在 X11 默认使用 EGL。部分 NVIDIA 环境会在 EGL 内部 context 初始化阶段明显卡顿。
# 仅当当前是 NVIDIA + X11 且用户没有显式 UseEGL 配置时，给该 Prefix 写入 Wine 官方
# 支持的 GLX fallback；已有全局或应用级配置仍由 Wine 自己按正常优先级处理。
has_global_useegl_setting() {
  local user_reg="$1"
  [[ -f "$user_reg" ]] || return 1

  awk '
    /^\[Software\\\\Wine\\\\X11 Driver\]/ { in_section = 1; next }
    /^\[/ { in_section = 0 }
    in_section && /^"UseEGL"=/ { found = 1; exit }
    END { exit found ? 0 : 1 }
  ' "$user_reg"
}

ensure_nvidia_x11_glx_default() {
  local prefix_dir user_reg tmp_file

  [[ -n "${DISPLAY:-}" ]] || return 0
  [[ -r /proc/driver/nvidia/version || -d /sys/module/nvidia ]] || return 0

  prefix_dir="${WINEPREFIX:-$HOME/.wine}"
  user_reg="$prefix_dir/user.reg"
  [[ -f "$user_reg" ]] || return 0
  has_global_useegl_setting "$user_reg" && return 0

  # 不再通过 wine reg add 设置该值，否则正式启动前会先额外启动一次 Wine，
  # 正好把 EGL 初始化的长等待重复执行一遍。仅在没有运行中的 wineserver 时，
  # 原子修改已有 Prefix 的 user.reg；新 Prefix 首次创建不预造注册表文件。
  if pgrep -u "$UID" -x 'wineserver|wineserver64' >/dev/null 2>&1; then
    return 0
  fi

  tmp_file="$(mktemp "${user_reg}.tmp.XXXXXX")"
  if ! awk '
    /^\[Software\\\\Wine\\\\X11 Driver\]/ && !inserted {
      print
      print "\"UseEGL\"=\"N\""
      inserted = 1
      next
    }
    { print }
    END {
      if (!inserted) {
        print ""
        print "[Software\\\\Wine\\\\X11 Driver]"
        print "\"UseEGL\"=\"N\""
      }
    }
  ' "$user_reg" > "$tmp_file"; then
    rm -f "$tmp_file"
    return 0
  fi

  chmod --reference="$user_reg" "$tmp_file" 2>/dev/null || chmod 0600 "$tmp_file"
  mv -f "$tmp_file" "$user_reg"
}

prepare_wine_launch() {
  local command_name="$1"
  shift

  case "$command_name" in
    wine|wine64)
      case "${1:-}" in
        --version|-v|--help|-h)
          return 0
          ;;
      esac
      ;;
    winecfg|regedit|wineboot)
      ;;
    *)
      return 0
      ;;
  esac

  ensure_nvidia_x11_glx_default
}

run_named_command() {
  local command_name="$1"
  shift

  if [[ -x "$WINE_ROOT/bin/$command_name" ]]; then
    prepare_wine_launch "$command_name" "$@"
    exec "$WINE_ROOT/bin/$command_name" "$@"
  fi
  if [[ -x "$APPDIR/usr/bin/$command_name" ]]; then
    exec "$APPDIR/usr/bin/$command_name" "$@"
  fi
  return 1
}

# 支持把同一个 wine.AppImage 链接成 wine、winecfg、wineserver、winetricks 等名称。
ENTRY_NAME="$(basename -- "${ARGV0:-${APPIMAGE:-$0}}")"
case "$ENTRY_NAME" in
  wine.AppImage|*.AppImage|AppRun|wrapper)
    ;;
  wine64)
    prepare_wine_launch wine64 "$@"
    if [[ -x "$WINE_ROOT/bin/wine64" ]]; then
      exec "$WINE_ROOT/bin/wine64" "$@"
    fi
    exec "$WINE_BIN" "$@"
    ;;
  *)
    if run_named_command "$ENTRY_NAME" "$@"; then
      exit 0
    fi
    ;;
esac

# 也允许直接写 wine.AppImage winecfg / wine.AppImage winetricks。
if (( $# > 0 )); then
  REQUESTED_COMMAND="$1"
  if [[ "$REQUESTED_COMMAND" != */* ]] && {
    [[ -x "$WINE_ROOT/bin/$REQUESTED_COMMAND" ]] ||
      [[ -x "$APPDIR/usr/bin/$REQUESTED_COMMAND" ]]
  }; then
    shift
    run_named_command "$REQUESTED_COMMAND" "$@"
  fi
fi

# 无参数时打开 winecfg；其余参数按官方 wine CLI 语义传递。
if (( $# == 0 )); then
  prepare_wine_launch winecfg
  exec "$WINE_ROOT/bin/winecfg"
fi
prepare_wine_launch wine "$@"
exec "$WINE_BIN" "$@"
